<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.shamusli.Doppelganger.service</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Doppelganger</string>
	<key>ProgramArguments</key>
	<array>
		<string>Doppelganger</string>
		<string>--service</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.shamusli.Doppelganger</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Always running while registered; it mounts or stays idle according to the user's choice. -->
	<key>KeepAlive</key>
	<true/>
	<!-- sshfs keeps running while the service restarts for an update; the new service takes it over. -->
	<key>AbandonProcessGroup</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
