+static void replay_lost_writes(void);
+
+/* Sends a request that names its file by path, and again if the connection
+   closes before the reply. '*repeated' tells whether it was sent again, so a
+   request that changes something can tell an error caused by the lost one
+   having taken effect. */
 static int sftp_request(struct conn *conn, uint8_t type, const struct buffer *buf,
-			uint8_t expect_type, struct buffer *outbuf)
+			uint8_t expect_type, struct buffer *outbuf, int *repeated)
 {
 	struct iovec iov;
+	int err = LOST;
+	int tries;
 
 	buf_to_iov(buf, &iov);
-	return sftp_request_iov(conn, type, &iov, 1, expect_type, outbuf);
+	/* Before each try: the writes may have been lost with the same
+	   connection, and a stat sent before them would report the size the
+	   file had without them, which macOS takes for the file's size and
+	   fills with zeros up to the next write */
+	for (tries = 0; err == LOST && tries < MAX_TRIES; tries++) {
+		replay_lost_writes();
+		err = sftp_request_iov(conn, -1, type, &iov, 1, expect_type,
+				       outbuf);
+	}
+	if (repeated)
+		*repeated = tries > 1;
+	return err == LOST ? -EIO : err;
+}
+
+/* Sends a request that opens a file or directory, and returns the handle with
+   the connection version it belongs to. A request that couldn't be sent, as
+   when the server can't be reached, counts as lost. */
+static int sftp_open_handle(struct conn *conn, uint8_t type,
+			    const struct buffer *buf, struct buffer *handle,
+			    int *connver)
+{
+	struct iovec iov;
+	struct request *req;
+	int err;
+	int sent;
+
+	buf_to_iov(buf, &iov);
+	sent = sftp_request_send(conn, -1, type, &iov, 1, NULL, NULL, 1, NULL,
+				 &req) == 0;
+	if (sent)
+		*connver = req->connver;
+	err = sftp_request_wait(req, type, SSH_FXP_HANDLE, handle);
+	if (!err)
+		buf_finish(handle);
+	return sent ? err : LOST;
+}
+
+/* Closes a handle without waiting; nothing is sent if its connection has
+   closed, which closed the handle too */
+static void sftp_close(struct conn *conn, int connver, struct buffer *handle)
+{
+	struct iovec iov;
+
+	buf_to_iov(handle, &iov);
+	sftp_request_iov(conn, connver, SSH_FXP_CLOSE, &iov, 1, 0, NULL);
+}
+
+/* Adds an open file's handle to 'buf', and returns the connection version it
+   belongs to */
+static int sf_add_handle(struct sshfs_file *sf, struct buffer *buf)
+{
+	int connver;
+
+	pthread_mutex_lock(&sf->lock);
+	buf_add_buf(buf, &sf->handle);
+	connver = sf->connver;
+	pthread_mutex_unlock(&sf->lock);
+	return connver;
+}
+
+static int sf_refresh(struct sshfs_file *sf);
+
+/* Sends a request about an open file and waits for the reply, opening the
+   file again first if its connection has closed. 'ext' names an extended
+   request; 'args' follow the handle. */
+static int sf_request(struct sshfs_file *sf, uint8_t type, const char *ext,
+		      const struct buffer *args, uint8_t expect_type,
+		      struct buffer *outbuf)
+{
+	int err = LOST;
+	int tries;
+
+	for (tries = 0; err == LOST && tries < MAX_TRIES; tries++) {
+		struct buffer buf;
+		struct iovec iov;
+		int connver;
+
+		err = sf_refresh(sf);
+		if (err)
+			break;
+		buf_init(&buf, 0);
+		if (ext)
+			buf_add_string(&buf, ext);
+		connver = sf_add_handle(sf, &buf);
+		if (args)
+			buf_add_buf(&buf, args);
+		buf_to_iov(&buf, &iov);
+		err = sftp_request_iov(sf->conn, connver, type, &iov, 1,
+				       expect_type, outbuf);
+		buf_free(&buf);
+	}
+	return err == LOST ? -EIO : err;
 }
 
