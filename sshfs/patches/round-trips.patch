+/* Sends a stat of the file behind the requests already sent for it, so its
+   reply shows their effect */
+static void sftp_stat_send(struct conn *conn, const char *path,
+			   struct sshfs_file *sf, struct request **reqp)
+{
+	struct buffer buf;
+	struct iovec iov;
+
+	buf_init(&buf, 0);
+	if (sf != NULL)
+		buf_add_buf(&buf, &sf->handle);
+	else
+		buf_add_path(&buf, path);
+	buf_to_iov(&buf, &iov);
+	sftp_request_send(conn, sf != NULL ? SSH_FXP_FSTAT :
+			  sshfs.follow_symlinks ? SSH_FXP_STAT : SSH_FXP_LSTAT,
+			  &iov, 1, NULL, NULL, 1, NULL, reqp);
+	buf_free(&buf);
+}
+
+/* Waits for the stat and, if 'ok', caches the attributes, which saves the
+   round trip of the getattr the kernel sends next */
+static void sftp_stat_cache(struct request *req, const char *path,
+			    uint64_t wrctr, int ok)
+{
+	struct buffer outbuf;
+	struct stat stbuf;
+
+	if (sftp_request_wait(req, SSH_FXP_LSTAT, SSH_FXP_ATTRS, &outbuf))
+		return;
+	if (ok && buf_get_attrs(&outbuf, &stbuf, NULL) == 0) {
+#ifdef __APPLE__
+		stbuf.st_blksize = 0;
+#endif
+		cache_add_attr(path, &stbuf, wrctr);
+	}
+	buf_free(&outbuf);
+}
+
+/* Sends a request that changes attributes together with a stat */
+static int sftp_setstat(struct conn *conn, uint8_t type,
+			const struct buffer *buf, const char *path,
+			struct sshfs_file *sf)
+{
+	int err;
+	struct request *req;
+	struct request *stat_req;
+	struct iovec iov;
+	uint64_t wrctr;
+
+	if (!sshfs.dir_cache)
+		return sftp_request(conn, type, buf, SSH_FXP_STATUS, NULL);
+
+	wrctr = cache_get_write_ctr();
+	buf_to_iov(buf, &iov);
+	sftp_request_send(conn, type, &iov, 1, NULL, NULL, 1, NULL, &req);
+	sftp_stat_send(conn, path, sf, &stat_req);
+	err = sftp_request_wait(req, type, SSH_FXP_STATUS, NULL);
+	sftp_stat_cache(stat_req, path, wrctr, !err);
+	if (sf != NULL)
+		sf->written = 0;
+	return err;
+}
